# ---------- Server ----------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173
# Public URL of the web app (used in invitation / password-reset links)
CLIENT_URL=http://localhost:5173

# Reverse proxies in front of the API: 0 = clients connect directly, 1 = behind Nginx. (default: 1 in production)
TRUST_PROXY=

# ---------- Identity + file storage provider ----------
# supabase = Supabase Auth + Storage (fill the SUPABASE_* values below)
# local    = accounts in DATABASE_URL (schema "auth") + files on this server's disk. Use for plain Postgres / RDS.
#            Run `npm run db:migrate` with AUTH_PROVIDER=local so supabase/standalone/bootstrap.sql is applied first.
AUTH_PROVIDER=supabase
STORAGE_PROVIDER=supabase
# local only: >= 32 random characters, e.g. `openssl rand -base64 48`. Rotating it signs everyone out.
AUTH_JWT_SECRET=
LOCAL_UPLOAD_DIR=./uploads
# optional absolute origin for signed file links (default: relative /api/files/... links)
PUBLIC_API_URL=

# ---------- Supabase ----------
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Public anon key (used by the API only for sign-up / sign-in / refresh calls)
SUPABASE_ANON_KEY=
# SERVICE ROLE KEY: backend only. Never expose to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Only for legacy projects that sign JWTs with a shared secret. Leave empty to use the project's JWKS.
SUPABASE_JWT_SECRET=
# Private storage bucket created by the migration
RESUME_BUCKET=resumes

# Direct Postgres connection string (Supabase > Project settings > Database > Connection string)
DATABASE_URL=
DATABASE_SSL=true

# ---------- Gemini (server side only) ----------
# Without a key every AI feature shows "AI not configured" and the rest of the app keeps working.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=30000

# ---------- Email (optional, off unless SMTP_HOST is set) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------- One-off scripts ----------
# npm run seed:admin   (leave ADMIN_PASSWORD empty to generate one)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Platform Admin
# npm run seed:demo    (development only; creates clearly labelled sample data)
SEED_DEMO=false
DEMO_PASSWORD=
